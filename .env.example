# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# MongoDB Connection URI (optional, for tracking users)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Force join channel (leave empty if not needed)
CHANNEL_USERNAME=@your_channel_username

# Webhook URL (Required for Webhook mode on Render, Koyeb, Railway, etc.)
# Example: https://your-app-name.onrender.com
# If left empty, bot will run in polling mode.
WEBHOOK_URL=

# Webhook endpoint path (defaults to /webhook)
WEBHOOK_PATH=/webhook

# Port (automatically assigned by Render/Railway/Heroku/Koyeb)
PORT=3000

# Custom TeraBox API endpoint (optional)
TERABOX_API_URL=https://alphaapis.org/terabox/v3/dl?url=
